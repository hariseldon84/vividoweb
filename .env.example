# Notion integration — add these in Vercel project settings > Environment Variables
NOTION_TOKEN=ntn_...
NOTION_DATABASE_ID=...

# Required Notion database properties (create these in your Notion database):
# Email          — Title type       (used as the unique identifier)
# YouTube Channel — URL type
# Created At     — Date type
# Page URL       — URL type
# Referrer       — Text type
# UTM Source     — Text type
# UTM Medium     — Text type
# UTM Campaign   — Text type
# UTM Content    — Text type
# UTM Term       — Text type
